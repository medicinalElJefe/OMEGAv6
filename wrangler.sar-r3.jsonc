{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omega-sar-r3",
  "main": "./sar-r3-worker.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./sar-accumulation-studio",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
