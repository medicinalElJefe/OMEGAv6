// CLOUD-01 is an ancillary autonomous source-evolution Worker. It may create governed GitHub source candidates but it is not OMEGA production deployment authority. Canonical production remains ci.yml -> wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omega-evolution-machine-r223",
  "main": "cloudflare/workerR223.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": true,
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "OMEGA_GITHUB_REPO": "medicinalElJefe/OMEGAv6",
    "OMEGA_PUBLIC_URL": "https://omegav6.jeffdeweyeljefe.workers.dev",
    "OMEGA_WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  },
  "observability": {
    "enabled": true
  }
}
