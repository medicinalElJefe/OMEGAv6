import assert from 'node:assert/strict';
import {DEFAULT_MOTION_R537,exportMotionSnapshotR537,importMotionSnapshotR537,motionSequenceR537,motionStepR537,motionTraceR537,validateMotionPacketR537} from '../src7/motionSourceR537';
const packet=(p:Partial<typeof DEFAULT_MOTION_R537>={})=>({...DEFAULT_MOTION_R537,...p});
assert.equal(motionStepR537(packet({tier:0,highRisk:true})).rule,'R5');
assert.equal(motionStepR537(packet({tier:0,highRisk:true})).after.highRisk,false);
assert.deepEqual(motionStepR537(packet({face:11,tier:2,highRisk:true,harmony:30})).after,{...packet({face:11,tier:2,highRisk:true,harmony:30}),face:0,tier:1});
assert.equal(motionStepR537(packet({tier:1,stability:90,harmony:90})).rule,'R1');
assert.equal(motionStepR537(packet({tier:1,adaptation:90,stability:20,harmony:90})).rule,'R2');
assert.equal(motionStepR537(packet({tier:-2,stability:20,adaptation:20,harmony:60})).after.tier,-1);
assert.equal(motionStepR537(packet({tier:3,stability:90,harmony:90})).rule,'R6');
assert.equal(motionStepR537(packet({tier:-3,adaptation:90,stability:20,harmony:90})).after.tier,-3);
const seq=motionSequenceR537(packet({tier:1,stability:90,harmony:90}),12);
assert.deepEqual(seq.slice(0,3).map(s=>s.rule),['R1','R1','R6']);
assert.deepEqual(seq,motionSequenceR537(packet({tier:1,stability:90,harmony:90}),12));
assert.ok(seq.every(s=>s.after.tier>=-3&&s.after.tier<=3&&s.after.face>=0&&s.after.face<=11));
const trace=motionTraceR537(packet({tier:1,stability:90,harmony:90}),12);
assert.equal(trace.cycleStart,2);
assert.equal(trace.cyclePeriod,1);
assert.equal(trace.terminal.tier,3);
assert.equal(trace.canonicalMutation,false);
assert.equal(motionTraceR537(packet({tier:0,highRisk:true}),3).cycleStart,1);
const snapshot=exportMotionSnapshotR537(packet({face:7,highRisk:true}),24);
assert.deepEqual(importMotionSnapshotR537(snapshot),JSON.parse(snapshot));
for(const bad of [{face:12},{tier:4},{stability:101},{harmony:NaN},{highRisk:'yes'}])assert.throws(()=>validateMotionPacketR537(packet(bad as any)),/INVALID_MOTION_PACKET/);
for(const bad of [0,-1,49,1.5])assert.throws(()=>motionSequenceR537(packet(),bad),/INVALID_SEQUENCE_LENGTH/);
for(const bad of ['{','x'.repeat(8193),JSON.stringify({...JSON.parse(snapshot),canonicalMutation:true}),JSON.stringify({...JSON.parse(snapshot),steps:99}),JSON.stringify({...JSON.parse(snapshot),packet:{...packet(),face:100}})])assert.throws(()=>importMotionSnapshotR537(bad));
console.log('R537 PASS: R1–R6, face wrap, tier bounds, packet admission, 48-step cap, local snapshot and refusals');
