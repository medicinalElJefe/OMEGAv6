import assert from 'node:assert/strict';
import {generateKeyPairSync,sign} from 'node:crypto';
import {DatabaseSync} from 'node:sqlite';
import {initializeAuthorityRegistry,provisionAuthorityKey,revokeAuthorityKey} from '../genesis/authorityRegistryR622';
import {promotionMessage,type SignedDeploymentPromotion} from '../genesis/signedPromotionR632';
import {initializePromotionLedger,recordSignedPromotion,auditSignedPromotion} from '../genesis/promotionLedgerR633';
const db=new DatabaseSync(':memory:');initializeAuthorityRegistry(db);initializePromotionLedger(db);
const pair=generateKeyPairSync('ed25519'),sha='a'.repeat(40),now='2026-10-18T12:00:00Z';
const key={keyId:'controller',principal:'release-controller',publicKeyPem:pair.publicKey.export({format:'pem',type:'spki'}).toString(),allowedScopes:['genesis:deploy:production'],revoked:false};
assert.equal(provisionAuthorityKey(db,key,'DEPLOYMENT_CONTROLLER'),true);
const p:SignedDeploymentPromotion={repository:'medicinalElJefe/OMEGAv6',candidateSha:sha,promotedSha:sha,environment:'production',deploymentId:'d1',deploymentStatus:'SUCCESS',deploymentUrl:'https://example.org',observedAt:now,controllerReceiptId:'r1',controllerKeyId:key.keyId,controllerPrincipal:key.principal,signatureBase64:''};
const signed={...p,signatureBase64:sign(null,Buffer.from(promotionMessage(p)),pair.privateKey).toString('base64')};
const record=(v:SignedDeploymentPromotion)=>recordSignedPromotion(db,v,p.repository,sha,'production',now);
assert.equal(record(signed).recorded,true);
assert.equal(auditSignedPromotion(db,'d1','production',p.repository,sha,now).valid,true);
assert.equal(record(signed).recorded,false);
assert.equal(record({...signed,promotedSha:'b'.repeat(40)}).recorded,false);
db.prepare('UPDATE genesis_promotion_ledger SET statement_hash=? WHERE deployment_id=?').run('0'.repeat(64),'d1');
assert.equal(auditSignedPromotion(db,'d1','production',p.repository,sha,now).valid,false);
assert.equal(revokeAuthorityKey(db,key.keyId),true);
assert.equal(auditSignedPromotion(db,'d1','production',p.repository,sha,now).valid,false);
db.close();
console.log('Genesis R633 signed promotion ledger, replay, tamper and revocation: PASS');
