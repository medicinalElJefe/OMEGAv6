import assert from 'node:assert/strict';
import {generateKeyPairSync,sign} from 'node:crypto';
import {DatabaseSync} from 'node:sqlite';
import {initActionLedger,recordConsumed} from '../genesis/actionLedgerR611';
import {claimDispatch} from '../genesis/dispatchClaimR617';
import {completionMessage,type CompletionAttestation} from '../genesis/completionAttestationR620';
import {auditCompletionEvidence} from '../genesis/completionEvidenceR621';
import {initializeAuthorityRegistry,provisionAuthorityKey,revokeAuthorityKey} from '../genesis/authorityRegistryR622';
import {initializeRegistryCompletion,recordRegistryAttestedCompletion} from '../genesis/registryCompletionR623';
const now='2026-10-17T12:00:00Z',pair=generateKeyPairSync('ed25519');
const key={keyId:'attestor',principal:'attestor',publicKeyPem:pair.publicKey.export({format:'pem',type:'spki'}).toString(),allowedScopes:['genesis:attest'],revoked:false};
const signed=(nonce:string):CompletionAttestation=>{const a:CompletionAttestation={nonce,proposalId:'p1',workerId:'w1',resultHash:'a'.repeat(64),completedAt:now,keyId:key.keyId,principal:key.principal,signatureBase64:''};return {...a,signatureBase64:sign(null,Buffer.from(completionMessage(a)),pair.privateKey).toString('base64')}};
const db=new DatabaseSync(':memory:');initActionLedger(db);initializeAuthorityRegistry(db);initializeRegistryCompletion(db);
for(const nonce of ['n1','n2','n3']){recordConsumed(db,nonce,'p1','w1',now);claimDispatch(db,nonce,'w1',now);}
assert.equal(recordRegistryAttestedCompletion(db,signed('n1'),now).recorded,false);
assert.equal(provisionAuthorityKey(db,key,'HUMAN_APPROVER'),true);
assert.equal(recordRegistryAttestedCompletion(db,signed('n1'),now).recorded,false);
assert.equal(provisionAuthorityKey(db,{...key,keyId:'attestor-2'},'COMPLETION_ATTESTOR'),true);
assert.equal(recordRegistryAttestedCompletion(db,signed('n1'),now).recorded,false);
const pair2=generateKeyPairSync('ed25519');
const key2={...key,keyId:'real-attestor',publicKeyPem:pair2.publicKey.export({format:'pem',type:'spki'}).toString()};
assert.equal(provisionAuthorityKey(db,key2,'COMPLETION_ATTESTOR'),true);
const a2:CompletionAttestation={...signed('n2'),keyId:key2.keyId,signatureBase64:''};
const good={...a2,signatureBase64:sign(null,Buffer.from(completionMessage(a2)),pair2.privateKey).toString('base64')};
assert.equal(recordRegistryAttestedCompletion(db,good,now).recorded,true);
assert.equal(auditCompletionEvidence(db,'n2',now).valid,true);
assert.equal(recordRegistryAttestedCompletion(db,good,now).recorded,false);
assert.equal(revokeAuthorityKey(db,key2.keyId),true);
const a3:CompletionAttestation={...good,nonce:'n3',signatureBase64:''};
const signed3={...a3,signatureBase64:sign(null,Buffer.from(completionMessage(a3)),pair2.privateKey).toString('base64')};
assert.equal(recordRegistryAttestedCompletion(db,signed3,now).recorded,false);
db.close();
console.log('Genesis R623 registry-attested completion, role veto and revocation: PASS');
