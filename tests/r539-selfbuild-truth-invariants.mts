import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {selfBuildTruthR539,R539_SCHEMA} from '../src7/selfBuildTruthR539';
const state=JSON.parse(readFileSync(new URL('../public/omega-r170-selfbuild-state.json',import.meta.url),'utf8'));
const actual=selfBuildTruthR539(state);
assert.equal(actual.schema,R539_SCHEMA);
assert.equal(actual.generation,state.generation);
assert.equal(actual.admitted,state.admittedSourceCapsules.length);
assert.equal(actual.sourceMerged,4);
assert.equal(actual.pendingSourceReview,1);
assert.equal(actual.sourceMerged+actual.pendingSourceReview,actual.admitted);
assert.ok(state.receipts.every((receipt:{canonicalAdmission?:boolean})=>receipt.canonicalAdmission!==true),'R539 must not imply CanonState admission');
assert.equal(actual.productionDeploymentProvenByThisState,false);
assert.equal(actual.autonomousSourceMutationNow,false);
assert.equal(actual.requiresSuccessorAdmission,true);
assert.equal(actual.phase,'ROADMAP_EXHAUSTED');
assert.equal(selfBuildTruthR539({...state,active:false}).phase,'INACTIVE');
assert.equal(selfBuildTruthR539({...state,currentCapsuleId:'SG006'}).phase,'WAITING_FOR_GOVERNED_MERGE');
assert.equal(selfBuildTruthR539({...state,maxAutonomousGenerations:6}).phase,'ELIGIBLE_FOR_GATED_SELECTION');
const view=readFileSync(new URL('../src7/workspaces/DevelopmentComputeWorkspaceR444.tsx',import.meta.url),'utf8');
assert.match(view,/SelfBuildTruthR539/);
assert.match(view,/<SelfBuildTruthR539\s*\/>/);
console.log('R539 self-build source truth invariants PASS · historical snapshot only · Development workspace integrated');
