import assert from 'node:assert/strict';
import {loadNoaaCatalogR682} from '../src/earthNoaaCatalogR682.ts';
const coverage=[{id:'G19-FD',label:'GOES-19 Full Disk',state:'RETURNED'}];
let calls=0;
const recovered=await loadNoaaCatalogR682(async()=>{
 calls++;
 if(calls<3)throw Error('Temporary NOAA catalogue transport outage');
 return coverage;
},{delaysMs:[0,0,0],sleep:async()=>{}});
assert.equal(calls,3);
assert.equal(recovered.state,'RETURNED');
assert.equal(recovered.attempts,3);
assert.deepEqual(recovered.rows,coverage);
assert.equal(recovered.syntheticImagery,false);
assert.equal(recovered.lastError,null);
const missing=await loadNoaaCatalogR682(async()=>[],{delaysMs:[0,0],sleep:async()=>{}});
assert.equal(missing.state,'ERROR');
assert.equal(missing.attempts,2);
assert.equal(missing.rows.length,0,'never invent unavailable coverage');
assert.match(missing.lastError||'',/zero coverage/);
const malformed=await loadNoaaCatalogR682(async()=>[{id:'bad/../path',label:'X',state:'RETURNED'}],{delaysMs:[0],sleep:async()=>{}});
assert.equal(malformed.state,'ERROR');
assert.equal(malformed.rows.length,0);
const dup=await loadNoaaCatalogR682(async()=>[coverage[0],coverage[0]],{delaysMs:[0],sleep:async()=>{}});
assert.equal(dup.state,'ERROR');
assert.match(dup.lastError||'',/duplicated/);
let current=true,cancelCount=0;
const cancelled=await loadNoaaCatalogR682(async()=>{cancelCount++;current=false;return coverage},{delaysMs:[0,0],isCurrent:()=>current,sleep:async()=>{}});
assert.equal(cancelled.state,'CANCELLED');
assert.equal(cancelled.rows.length,0);
assert.equal(cancelCount,1);
assert.throws(()=>loadNoaaCatalogR682(async()=>coverage,{delaysMs:[-1]}),/invalid retry horizon/);
assert.throws(()=>loadNoaaCatalogR682(async()=>coverage,{delaysMs:Array(6).fill(0)}),/invalid retry horizon/);
console.log('R682 PASS: bounded real NOAA catalogue recovery, no fabricated imagery, duplicate/path rejection, cancellation and source failure truth');
