import assert from 'node:assert/strict';
import {decide,evaluateCycle,ingestObservation,initializeCycle,preserveQuestion,propose} from '../genesis/cycleR607';
import {verifyChain} from '../genesis/kernelR606';
const now='2026-10-17T12:00:00Z';
const o={id:'fixture-001',source:'fixture://public',timestamp:now,value:{resource:2},truth:'OBSERVED' as const,consent:'public',uncertainty:0.25};
const p={id:'candidate-001',observationIds:['fixture-001'],action:'produce report only',scope:'proposal:write',benefit:'more options',risks:['incorrect inference'],alternatives:['no action','collect data'],reversible:true,humanDecision:'PENDING' as const,evidenceIds:['fixture-proof']};
let c=initializeCycle('genesis-r607-fixture');
c=ingestObservation(c,o);
assert.throws(()=>ingestObservation(c,o),/duplicate/);
assert.throws(()=>propose(c,{...p,observationIds:['not-observed']}),/observed evidence/);
c=propose(c,p);
c=preserveQuestion(c,'What evidence is still missing?');
assert.deepEqual(c.openQuestions,['What evidence is still missing?']);
const auth={principal:'human',scopes:['proposal:write'],expiresAt:'2026-12-01T00:00:00Z',humanApprovedProposalIds:[p.id]};
let held=evaluateCycle(c,auth,now);
assert.equal(held.rejected.length,1);
assert.match(held.rejected[0].reasons.join(' '),/human approval/);
c=decide(c,p.id,'APPROVED','fixture-human');
assert.throws(()=>decide(c,p.id,'DENIED','fixture-human'),/already finalized/);
const evaluated=evaluateCycle(c,auth,now);
assert.equal(evaluated.rejected.length,0);
assert.equal(evaluated.receipts.at(-1)?.kind,'ADMISSION_CANDIDATE');
assert.equal(verifyChain(evaluated.receipts),true);
const denied=evaluateCycle(c,{...auth,scopes:[]},now);
assert.equal(denied.rejected.length,1);
assert.match(denied.rejected[0].reasons.join(' '),/scope denied/);
console.log('Genesis R607 observation, consent, human decision, admission, negative controls and chain: PASS');
