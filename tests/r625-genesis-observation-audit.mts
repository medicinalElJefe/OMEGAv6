import {auditObservedCompletion} from '../genesis/observationAuditR625';
const dir=mkdtempSync(join(tmpdir(),'genesis-r625-')),path=join(dir,'audit.sqlite'),now='2026-10-17T12:00:00Z';
try{
 const db=new DatabaseSync(path);db.exec('PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL;');
 initActionLedger(db);initializeAuthorityRegistry(db);initializeCompletionEvidence(db);initializeObservationLedger(db);
 const att=generateKeyPairSync('ed25519'),obs=generateKeyPairSync('ed25519');
 const ak={keyId:'att',principal:'attestor',publicKeyPem:att.publicKey.export({format:'pem',type:'spki'}).toString(),allowedScopes:['genesis:attest'],revoked:false};
 const ok={keyId:'obs',principal:'observer',publicKeyPem:obs.publicKey.export({format:'pem',type:'spki'}).toString(),allowedScopes:['genesis:observe'],revoked:false};
 assert.equal(provisionAuthorityKey(db,ak,'COMPLETION_ATTESTOR'),true);
 assert.equal(provisionAuthorityKey(db,ok,'INDEPENDENT_OBSERVER'),true);
 recordConsumed(db,'n1','p1','w1',now);claimDispatch(db,'n1','w1',now);
 const a:CompletionAttestation={nonce:'n1',proposalId:'p1',workerId:'w1',resultHash:'a'.repeat(64),completedAt:now,keyId:ak.keyId,principal:ak.principal,signatureBase64:''};
 const sa={...a,signatureBase64:sign(null,Buffer.from(completionMessage(a)),att.privateKey).toString('base64')};
 assert.equal(recordRegistryAttestedCompletion(db,sa,now).recorded,true);
 const receipt=(db.prepare('SELECT receipt_hash FROM genesis_action_ledger WHERE nonce=?').get('n1') as {receipt_hash:string}).receipt_hash;
 const o:SignedObservation={nonce:'n1',proposalId:'p1',workerId:'w1',receiptHash:receipt,observedResultHash:a.resultHash,observedAt:now,observerKeyId:ok.keyId,observerPrincipal:ok.principal,signatureBase64:''};
 const so={...o,signatureBase64:sign(null,Buffer.from(observationMessage(o)),obs.privateKey).toString('base64')};
 assert.equal(recordIndependentObservation(db,so,now).recorded,true);
