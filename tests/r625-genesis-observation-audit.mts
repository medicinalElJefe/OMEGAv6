import assert from 'node:assert/strict';
import {generateKeyPairSync,sign} from 'node:crypto';
import {DatabaseSync} from 'node:sqlite';
import {mkdtempSync,rmSync} from 'node:fs';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import {initActionLedger,recordConsumed} from '../genesis/actionLedgerR611';
import {claimDispatch} from '../genesis/dispatchClaimR617';
import {completionMessage,type CompletionAttestation} from '../genesis/completionAttestationR620';
import {initializeCompletionEvidence} from '../genesis/completionEvidenceR621';
import {initializeAuthorityRegistry,provisionAuthorityKey,revokeAuthorityKey} from '../genesis/authorityRegistryR622';
import {recordRegistryAttestedCompletion} from '../genesis/registryCompletionR623';
