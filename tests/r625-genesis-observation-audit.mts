 assert.equal(revokeAuthorityKey(reopened,'obs'),true);
 assert.equal(auditObservedCompletion(reopened,'n1',now).valid,false);
 reopened.close();
 console.log('Genesis R625 restart audit, cross-record integrity and revocation: PASS');
}finally{rmSync(dir,{recursive:true,force:true})}
