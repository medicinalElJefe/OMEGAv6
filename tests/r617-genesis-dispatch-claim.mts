assert.equal(transitionAction(db,'n2','RECONCILE','COMPLETED',at,'a'.repeat(64)),false);
assert.equal(DISPATCH_POLICY,'NO_HOST_EXECUTION_WITHOUT_EXTERNAL_WORKER_FENCE');
db.close();
console.log('Genesis R617 dispatch CAS, worker isolation, no replay and reconciliation: PASS');
