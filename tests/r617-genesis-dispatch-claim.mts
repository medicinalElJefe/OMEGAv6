import assert from 'node:assert/strict';
import {DatabaseSync} from 'node:sqlite';
import {initActionLedger,recordConsumed,reconcileInterrupted,transitionAction} from '../genesis/actionLedgerR611';
import {claimDispatch,markDispatchFailed,DISPATCH_POLICY} from '../genesis/dispatchClaimR617';
const db=new DatabaseSync(':memory:');initActionLedger(db);
const at='2026-10-17T12:00:00Z';
