assert.equal(recordConsumed(db,'n1','p1','w1',at),true);
assert.equal(claimDispatch(db,'n1','w2',at).claimed,false);
assert.equal(claimDispatch(db,'n1','w1',at).claimed,true);
assert.equal(claimDispatch(db,'n1','w1',at).claimed,false);
