import assert from 'node:assert/strict';
import {R681_DECISION_AUDIT,R681_SOURCE_SHA,reviewNativeDecisionTruthR681} from '../src7/workspaces/nativeDecisionTruthR681.ts';

const report=reviewNativeDecisionTruthR681(R681_DECISION_AUDIT);
assert.equal(report.schema,'OMEGA_NATIVE_DECISION_PROOF_GATE_R681');
assert.equal(report.snapshotVerified,true); // Historical compatibility: digest string equality only
assert.equal(report.snapshotDigestMatchesReference,true);
assert.equal(report.sourceBytesIndependentlyVerifiedInBrowser,false,'static UI cannot claim original SQLite byte validation');
assert.equal(report.admission,'HELD');
assert.equal(report.canonicalStateMutation,false);
assert.equal(report.useAsAutonomousNativePolicy,false);
assert.equal(report.disagreements,84);
assert.ok(Math.abs(report.entropyBits!-0.015276962177938797)<1e-12);
assert.ok(Math.abs(report.dominantFraction!-20707/20736)<1e-15);
assert.equal(R681_DECISION_AUDIT.archivedStabilityRatioResidualRows,20736);
assert.equal(R681_DECISION_AUDIT.archivedTurnPressureResidualRows,0);
for(const required of ['STAY_CLASS_NOT_DISCRIMINATED','SAVED_DECISION_CLASS_CONCENTRATION_OVER_95_PERCENT','ORIGINAL_DECISIONS_DISAGREE_WITH_RECOVERED_KERNEL','ORIGINAL_SAVED_DIAGNOSTICS_DISAGREE_WITH_RECOVERED_KERNEL','INDEPENDENT_EMPIRICAL_OUTCOME_CALIBRATION_MISSING','R125_EXTERNAL_ADMISSION_PROOF_REQUIRED'])
 assert.ok(report.vetoes.includes(required),'Missing proof veto '+required);
const copy=()=>structuredClone(R681_DECISION_AUDIT) as any;
const forgedSource=copy();forgedSource.snapshotSha256='0'.repeat(64);
assert.equal(reviewNativeDecisionTruthR681({...forgedSource,sourceSha256:forgedSource.snapshotSha256}).snapshotVerified,false);
const forgedCounts=copy();forgedCounts.stored.STAY=200;
assert.ok(reviewNativeDecisionTruthR681({...forgedCounts,sourceSha256:R681_SOURCE_SHA}).vetoes.includes('INCOMPLETE_NATIVE_DECISION_CENSUS'));
const forgedConservation=copy();forgedConservation.savedVsRecoveredKernel.TURN_to_STAY=1;
assert.ok(reviewNativeDecisionTruthR681({...forgedConservation,sourceSha256:R681_SOURCE_SHA}).vetoes.includes('CONTRADICTION_LEDGER_NOT_CONSERVED'));
const forgedNegatives=copy();forgedNegatives.recomputed.STAY=-1;
assert.ok(reviewNativeDecisionTruthR681({...forgedNegatives,sourceSha256:R681_SOURCE_SHA}).vetoes.includes('INVALID_NATIVE_DECISION_COUNTS'));
const seeminglyPerfect=copy();
seeminglyPerfect.stored={STAY:6912,TURN:6912,ESCALATE:6912};
seeminglyPerfect.recomputed={...seeminglyPerfect.stored};
seeminglyPerfect.savedVsRecoveredKernel={TURN_to_STAY:0,ESCALATE_to_TURN:0,ESCALATE_to_STAY:0};
seeminglyPerfect.archivedStabilityRatioResidualRows=0;
seeminglyPerfect.empiricalOutcomeLabels=20736;
seeminglyPerfect.originalGeneratorVersionProven=true;
seeminglyPerfect.physicalCalibrationProven=true;
seeminglyPerfect.productionNativePolicyCertified=true;
const shadow=reviewNativeDecisionTruthR681({...seeminglyPerfect,sourceSha256:R681_SOURCE_SHA});
assert.equal(shadow.admission,'HELD','local projection never issues canonical release authority');
assert.ok(shadow.vetoes.includes('R125_EXTERNAL_ADMISSION_PROOF_REQUIRED'));
assert.deepEqual(report,reviewNativeDecisionTruthR681(R681_DECISION_AUDIT),'deterministic proof replay');
console.log('R681 PASS: source-verified native source audit, 84 contradictions, all 20736 cached-ratio disagreements, conserved labels, forged report rejection and absolute R125 release veto');
