import assert from 'node:assert/strict';
import {generateKeyPairSync,sign} from 'node:crypto';
import {DatabaseSync} from 'node:sqlite';
import {commitProposal} from '../genesis/executionBoundaryR609';
import {decisionMessage,type SignedDecision} from '../genesis/independentProofR608';
import {executionLeaseMessage,type SignedExecutionLease} from '../genesis/signedLeaseR613';
import {initializeAuthorityRegistry,provisionAuthorityKey,revokeAuthorityKey,resolveTrustedAuthority} from '../genesis/authorityRegistryR622';
import {initializeRegistryAdmission,admitFromTrustedRegistry} from '../genesis/registryAdmissionR622';
const p={id:'p1',observationIds:['o1'],action:'propose',scope:'proposal:write',benefit:'clarity',risks:['mistake'],alternatives:['wait'],reversible:true,humanDecision:'PENDING' as const,evidenceIds:['e1']};
const h=generateKeyPairSync('ed25519'),i=generateKeyPairSync('ed25519'),rogue=generateKeyPairSync('ed25519');
const human={keyId:'human',principal:'human',publicKeyPem:h.publicKey.export({format:'pem',type:'spki'}).toString(),allowedScopes:[p.scope],revoked:false};
const issuer={keyId:'issuer',principal:'issuer',publicKeyPem:i.publicKey.export({format:'pem',type:'spki'}).toString(),allowedScopes:[p.scope],revoked:false};
const now='2026-10-17T12:00:00Z',issuedAt='2026-10-17T11:00:00Z',expiresAt='2026-10-17T13:00:00Z';
const makeDecision=(nonce:string):SignedDecision=>{const d:SignedDecision={proposalId:p.id+':'+commitProposal(p).contentHash,decision:'APPROVED',principal:'human',scope:p.scope,issuedAt,expiresAt,nonce,keyId:human.keyId,signatureBase64:''};return {...d,signatureBase64:sign(null,Buffer.from(decisionMessage(d)),h.privateKey).toString('base64')}};
const makeLease=(nonce:string):SignedExecutionLease=>{const l:SignedExecutionLease={proposalId:p.id,proposalHash:commitProposal(p).contentHash,principal:'issuer',scope:p.scope,workerId:'w1',issuedAt,expiresAt,nonce,maxUses:1,issuerKeyId:issuer.keyId,signatureBase64:''};return {...l,signatureBase64:sign(null,Buffer.from(executionLeaseMessage(l)),i.privateKey).toString('base64')}};
const db=new DatabaseSync(':memory:');initializeRegistryAdmission(db);
assert.equal(provisionAuthorityKey(db,human,'HUMAN_APPROVER'),true);
assert.equal(provisionAuthorityKey(db,issuer,'LEASE_ISSUER'),true);
assert.equal(provisionAuthorityKey(db,{...human,publicKeyPem:rogue.publicKey.export({format:'pem',type:'spki'}).toString()},'HUMAN_APPROVER'),false);
assert.equal(resolveTrustedAuthority(db,'human','LEASE_ISSUER'),null);
assert.equal(admitFromTrustedRegistry(db,p,{...makeDecision('d0'),signatureBase64:'invalid'},makeLease('l0'),'w1',now).admitted,false);
assert.equal(admitFromTrustedRegistry(db,p,makeDecision('d1'),makeLease('l1'),'w1',now).admitted,true);
assert.equal(admitFromTrustedRegistry(db,p,makeDecision('d1'),makeLease('l2'),'w1',now).admitted,false);
assert.equal(revokeAuthorityKey(db,'issuer'),true);
assert.equal(admitFromTrustedRegistry(db,p,makeDecision('d3'),makeLease('l3'),'w1',now).admitted,false);
assert.equal(resolveTrustedAuthority(db,'issuer','LEASE_ISSUER'),null);
db.close();
console.log('Genesis R622 registry roles, pinned keys, replay and revocation: PASS');
