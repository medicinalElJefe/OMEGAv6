import assert from 'node:assert/strict';
import {appendReceipt,developmentalStep,evaluateProposal,validateObservation,verifyChain} from '../genesis/kernelR606';
const observation={id:'public-energy-001',source:'fixture://public-energy',timestamp:'2026-10-17T00:00:00Z',value:{load:1},truth:'OBSERVED' as const,consent:'public',uncertainty:0.1};
const proposal={id:'proposal-001',observationIds:[observation.id],action:'generate non-operational energy proposal',scope:'proposal:write',benefit:'reviewable alternatives',risks:['incorrect assumptions'],alternatives:['do nothing','request more data'],reversible:true,humanDecision:'APPROVED' as const,evidenceIds:['test-001']};
const authority={principal:'human',scopes:['proposal:write'],expiresAt:'2026-12-01T00:00:00Z',humanApprovedProposalIds:[proposal.id]};
const now='2026-10-17T12:00:00Z';
assert.deepEqual(validateObservation(observation),[]);
assert.equal(evaluateProposal(proposal,[observation],authority,now).admitted,true);
assert.equal(evaluateProposal({...proposal,humanDecision:'PENDING'},[observation],authority,now).admitted,false);
assert.equal(evaluateProposal(proposal,[observation],{...authority,scopes:[]},now).admitted,false);
assert.equal(evaluateProposal(proposal,[observation],authority,'2027-01-01T00:00:00Z').admitted,false);
assert.equal(evaluateProposal({...proposal,evidenceIds:[]},[observation],authority,now).admitted,false);
assert.equal(evaluateProposal({...proposal,alternatives:[]},[observation],authority,now).admitted,false);
assert.equal(evaluateProposal({...proposal,observationIds:['missing']},[observation],authority,now).admitted,false);
const a=appendReceipt([],'OBSERVE',observation.id,observation);
const b=appendReceipt([a],'PROPOSE',proposal.id,proposal);
assert.equal(verifyChain([a,b]),true);
assert.equal(verifyChain([a,{...b,previousHash:'tampered'}]),false);
const next=developmentalStep({continuity:0.68,scar:0.99,contradictions:['old']},['new']);
assert.deepEqual(next.contradictions,['old','new']);
assert.equal(next.scar,0.99);
console.log('Genesis R606 admission, negative controls, receipt chain, scar carry: PASS');
