import assert from 'node:assert/strict';
import {generateKeyPairSync,sign} from 'node:crypto';
import {DatabaseSync} from 'node:sqlite';
import {initializeAuthorityRegistry,provisionAuthorityKey,revokeAuthorityKey} from '../genesis/authorityRegistryR622';
import {promotionMessage,verifySignedPromotion,type SignedDeploymentPromotion} from '../genesis/signedPromotionR632';
const db=new DatabaseSync(':memory:');initializeAuthorityRegistry(db);
const pair=generateKeyPairSync('ed25519'),sha='a'.repeat(40),now='2026-10-18T12:00:00Z';
const key={keyId:'controller',principal:'release-controller',publicKeyPem:pair.publicKey.export({format:'pem',type:'spki'}).toString(),allowedScopes:['genesis:deploy:production'],revoked:false};
const p:SignedDeploymentPromotion={repository:'medicinalElJefe/OMEGAv6',candidateSha:sha,promotedSha:sha,environment:'production',deploymentId:'d1',deploymentStatus:'SUCCESS',deploymentUrl:'https://example.org',observedAt:now,controllerReceiptId:'r1',controllerKeyId:key.keyId,controllerPrincipal:key.principal,signatureBase64:''};
const signed={...p,signatureBase64:sign(null,Buffer.from(promotionMessage(p)),pair.privateKey).toString('base64')};
const verify=(x:SignedDeploymentPromotion)=>verifySignedPromotion(db,x,p.repository,sha,'production',now).valid;
assert.equal(verify(signed),false);
assert.equal(provisionAuthorityKey(db,key,'HUMAN_APPROVER'),true);
assert.equal(verify(signed),false);
const second=generateKeyPairSync('ed25519'),key2={...key,keyId:'controller2',publicKeyPem:second.publicKey.export({format:'pem',type:'spki'}).toString()};
assert.equal(provisionAuthorityKey(db,key2,'DEPLOYMENT_CONTROLLER'),true);
const p2={...p,controllerKeyId:key2.keyId,signatureBase64:''};
const signed2={...p2,signatureBase64:sign(null,Buffer.from(promotionMessage(p2)),second.privateKey).toString('base64')};
assert.equal(verify(signed2),true);
assert.equal(verify({...signed2,promotedSha:'b'.repeat(40)}),false);
assert.equal(verify({...signed2,signatureBase64:'invalid'}),false);
assert.equal(revokeAuthorityKey(db,key2.keyId),true);
assert.equal(verify(signed2),false);
db.close();
console.log('Genesis R632 controller role, signed promotion, tamper and revocation: PASS');
