import assert from 'node:assert/strict';
import {generateKeyPairSync,sign as cryptoSign,createHash} from 'node:crypto';
import {decisionMessage,evidenceHash,verifyEvidenceLink,verifySignedDecision,type SignedDecision} from '../genesis/independentProofR608';
const {publicKey,privateKey}=generateKeyPairSync('ed25519');
const now='2026-10-17T12:00:00Z';
const base:SignedDecision={proposalId:'p1',decision:'APPROVED',principal:'human-1',scope:'proposal:write',issuedAt:'2026-10-17T11:00:00Z',expiresAt:'2026-10-17T13:00:00Z',nonce:'once-1',keyId:'key-1',signatureBase64:''};
const signed={...base,signatureBase64:cryptoSign(null,Buffer.from(decisionMessage(base)),privateKey).toString('base64')};
const key={keyId:'key-1',principal:'human-1',publicKeyPem:publicKey.export({format:'pem',type:'spki'}).toString(),allowedScopes:['proposal:write'],revoked:false};
assert.equal(verifySignedDecision(signed,key,now,new Set()).valid,true);
assert.equal(verifySignedDecision({...signed,scope:'execute:host'},key,now,new Set()).valid,false);
assert.equal(verifySignedDecision(signed,{...key,revoked:true},now,new Set()).valid,false);
assert.equal(verifySignedDecision(signed,key,now,new Set(['once-1'])).valid,false);
assert.equal(verifySignedDecision(signed,key,'2026-10-17T14:00:00Z',new Set()).valid,false);
assert.equal(verifySignedDecision({...signed,proposalId:'p2'},key,now,new Set()).valid,false);
const evidence={subject:'p1',sourceId:'fixture',payloadHash:createHash('sha256').update('payload').digest('hex'),previousHash:'GENESIS',sequence:0,recordedAt:now};
assert.equal(verifyEvidenceLink(evidence,'GENESIS',0).valid,true);
assert.equal(verifyEvidenceLink(evidence,'bad',0).valid,false);
assert.equal(evidenceHash(evidence).length,64);
console.log('Genesis R608 signature, scope, revocation, replay, expiry, evidence link: PASS');
