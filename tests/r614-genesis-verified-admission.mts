import assert from 'node:assert/strict';
import {generateKeyPairSync,sign} from 'node:crypto';
import {DatabaseSync} from 'node:sqlite';
import {commitProposal} from '../genesis/executionBoundaryR609';
import {executionLeaseMessage,type SignedExecutionLease} from '../genesis/signedLeaseR613';
import {initializeAtomicAdmission} from '../genesis/atomicAdmissionR612';
import {admitSignedLease} from '../genesis/verifiedAdmissionR614';
const p={id:'p1',observationIds:['o1'],action:'propose',scope:'proposal:write',benefit:'clarity',risks:['mistake'],alternatives:['wait'],reversible:true,humanDecision:'PENDING' as const,evidenceIds:['e1']};
const {privateKey,publicKey}=generateKeyPairSync('ed25519');
const issuer={keyId:'key-1',principal:'issuer-1',publicKeyPem:publicKey.export({format:'pem',type:'spki'}).toString(),allowedScopes:['proposal:write'],revoked:false};
const lease:SignedExecutionLease={proposalId:p.id,proposalHash:commitProposal(p).contentHash,principal:issuer.principal,scope:p.scope,workerId:'w1',issuedAt:'2026-10-17T11:00:00Z',expiresAt:'2026-10-17T13:00:00Z',nonce:'nonce-1',maxUses:1,issuerKeyId:issuer.keyId,signatureBase64:''};
const signed={...lease,signatureBase64:sign(null,Buffer.from(executionLeaseMessage(lease)),privateKey).toString('base64')};
const db=new DatabaseSync(':memory:');initializeAtomicAdmission(db);
const now='2026-10-17T12:00:00Z';
const admit=(l:SignedExecutionLease,k=issuer,proposal=p)=>admitSignedLease(db,proposal,l,k,'w1',now);
assert.equal(admit({...signed,signatureBase64:'tampered'}).admitted,false);
assert.equal(admit(signed,{...issuer,revoked:true}).admitted,false);
assert.equal(admit(signed,issuer,{...p,action:'changed'}).admitted,false);
assert.equal(db.prepare('SELECT count(*) AS n FROM genesis_consumed_leases').get()?.n,0);
