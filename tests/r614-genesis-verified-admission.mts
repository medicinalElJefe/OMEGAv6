assert.equal(admit(signed).admitted,false);
assert.equal(db.prepare('SELECT count(*) AS n FROM genesis_consumed_leases').get()?.n,1);
assert.equal(db.prepare('SELECT count(*) AS n FROM genesis_action_ledger').get()?.n,1);
db.close();
console.log('Genesis R614 signature-to-atomic-admission positive/negative controls: PASS');
