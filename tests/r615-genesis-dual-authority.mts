const issuerKey={keyId:'issuer-key',principal:'issuer',publicKeyPem:issuerPair.publicKey.export({format:'pem',type:'spki'}).toString(),allowedScopes:['proposal:write'],revoked:false};
const now='2026-10-17T12:00:00Z';
const decision:SignedDecision={proposalId:p.id+':'+commitProposal(p).contentHash,decision:'APPROVED',principal:'human',scope:p.scope,issuedAt:'2026-10-17T11:00:00Z',expiresAt:'2026-10-17T13:00:00Z',nonce:'human-nonce',keyId:humanKey.keyId,signatureBase64:''};
const signedDecision={...decision,signatureBase64:sign(null,Buffer.from(decisionMessage(decision)),humanPair.privateKey).toString('base64')};
const lease:SignedExecutionLease={proposalId:p.id,proposalHash:commitProposal(p).contentHash,principal:'issuer',scope:p.scope,workerId:'w1',issuedAt:decision.issuedAt,expiresAt:decision.expiresAt,nonce:'lease-nonce',maxUses:1,issuerKeyId:issuerKey.keyId,signatureBase64:''};
