import assert from 'node:assert/strict';
import {generateKeyPairSync,sign} from 'node:crypto';
import {decisionMessage,type SignedDecision} from '../genesis/independentProofR608';
import {commitProposal,verifyProposalApproval,verifyExecutionLease,EXECUTION_GATE} from '../genesis/executionBoundaryR609';
const p={id:'p1',observationIds:['o1'],action:'write proposal only',scope:'proposal:write',benefit:'clarity',risks:['error'],alternatives:['wait'],reversible:true,humanDecision:'PENDING' as const,evidenceIds:['e1']};
const {privateKey,publicKey}=generateKeyPairSync('ed25519');
const key={keyId:'k1',principal:'person-1',publicKeyPem:publicKey.export({format:'pem',type:'spki'}).toString(),allowedScopes:['proposal:write'],revoked:false};
const now='2026-10-17T12:00:00Z';
const base:SignedDecision={proposalId:p.id+':'+commitProposal(p).contentHash,decision:'APPROVED',principal:'person-1',scope:p.scope,issuedAt:'2026-10-17T11:00:00Z',expiresAt:'2026-10-17T13:00:00Z',nonce:'approval-once',keyId:'k1',signatureBase64:''};
const d={...base,signatureBase64:sign(null,Buffer.from(decisionMessage(base)),privateKey).toString('base64')};
assert.equal(verifyProposalApproval(p,d,key,now,new Set()).allowed,true);
assert.equal(verifyProposalApproval({...p,action:'execute on host'},d,key,now,new Set()).allowed,false);
assert.equal(verifyProposalApproval(p,{...d,decision:'DENIED'},key,now,new Set()).allowed,false);
assert.equal(verifyProposalApproval(p,d,key,now,new Set(['approval-once'])).allowed,false);
const lease={proposalId:p.id,proposalHash:commitProposal(p).contentHash,principal:'issuer-1',scope:p.scope,workerId:'pc-1',issuedAt:'2026-10-17T11:00:00Z',expiresAt:'2026-10-17T13:00:00Z',nonce:'lease-1',maxUses:1};
assert.equal(verifyExecutionLease(p,lease,'pc-1',now,0).allowed,true);
assert.equal(verifyExecutionLease(p,lease,'pc-2',now,0).allowed,false);
assert.equal(verifyExecutionLease({...p,action:'different'},lease,'pc-1',now,0).allowed,false);
assert.equal(verifyExecutionLease(p,lease,'pc-1',now,1).allowed,false);
assert.equal(verifyExecutionLease(p,{...lease,maxUses:10},'pc-1',now,0).allowed,false);
assert.equal(EXECUTION_GATE,'HOLD_UNTIL_EXTERNAL_ISSUER_AND_ATOMIC_CONSUME');
console.log('Genesis R609 content-bound approval, lease rejection, external-execution HOLD: PASS');
