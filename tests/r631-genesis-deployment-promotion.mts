import assert from 'node:assert/strict';
import {verifyPromotionRecord,PROMOTION_BOUNDARY} from '../genesis/deploymentPromotionR631';
const sha='a'.repeat(40);
const p={repository:'medicinalElJefe/OMEGAv6',candidateSha:sha,promotedSha:sha,environment:'production',deploymentId:'deployment-1',deploymentStatus:'SUCCESS' as const,deploymentUrl:'https://example.org/omega',observedAt:'2026-10-18T12:00:00Z',controllerReceiptId:'controller-1'};
const run=(v= p)=>verifyPromotionRecord(v,p.repository,sha,'production');
assert.equal(run().promotionConfirmed,true);
assert.equal(run().browserVerified,false);
assert.equal(run().capabilitiesVerified,false);
assert.equal(run({...p,promotedSha:'b'.repeat(40)}).promotionConfirmed,false);
assert.equal(run({...p,candidateSha:'b'.repeat(40)}).promotionConfirmed,false);
assert.equal(run({...p,environment:'staging'}).promotionConfirmed,false);
assert.equal(run({...p,deploymentStatus:'PENDING'}).promotionConfirmed,false);
assert.equal(run({...p,deploymentUrl:'http://example.org'}).promotionConfirmed,false);
assert.equal(run({...p,controllerReceiptId:''}).promotionConfirmed,false);
