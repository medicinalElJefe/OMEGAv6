assert.notEqual(run('historical-rh-traversal',{OMEGA_EXPECTED_SHA:'a'.repeat(40),OMEGA_PUBLIC_URL:'http://example.org'}).status,0);
console.log('Genesis R636 browser execution wrapper: fail-closed configuration PASS');
