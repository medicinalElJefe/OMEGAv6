{
  "name": "omegav6-full-restore",
  "version": "13.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "test:routes": "node tests/route-cases.mjs",
    "test:restore": "node tests/restore-invariants.mjs",
    "test:navigation": "node tests/navigation-coherence.mjs",
    "test:home": "node tests/home-instrument-invariants.mjs && node tests/home-quick-nav-invariants.mjs",
    "test:portability": "node tests/portability-invariants.mjs",
    "test:applications": "node tests/full-application-routing.mjs",
    "test:cloud": "node tests/cloud-bridge-invariants.mjs",
    "check:static": "node --check src/worker.js && npm run test:routes && npm run test:restore && npm run test:navigation && npm run test:home && npm run test:portability && npm run test:applications && npm run test:cloud",
