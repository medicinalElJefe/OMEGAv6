{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"OMEGA_RESULT_v1",
  "title":"OMEGA Worker Result v1",
  "type":"object",
  "required":["schema","packet_id","source_packet_id","worker","solver","solver_version","converged","convergence_metrics","observables","runtime_ms","lineage","completed_at"],
  "properties":{
    "schema":{"const":"OMEGA_RESULT_v1"},
    "packet_id":{"type":"string"},
    "source_packet_id":{"type":"string"},
    "worker":{"enum":["omega-genesis","omega-optical","omega-sovereign"]},
    "solver":{"enum":["scalar","rcwa","fdtd","fem"]},
    "solver_version":{"type":"string"},
    "converged":{"type":"boolean"},
    "convergence_metrics":{"type":"object"},
    "observables":{"type":"object"},
    "artifacts":{"type":"object","additionalProperties":{"type":"string"}},
    "runtime_ms":{"type":"number","minimum":0},
    "lineage":{"type":"array","items":{"type":"string"}},
    "completed_at":{"type":"string"}
  },
  "additionalProperties":true
}