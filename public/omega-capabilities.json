{
  "schema": "OMEGA_CAPABILITIES_v1",
  "compatibility": {"packet": ["OMEGA_PACKET_v1"], "result": ["OMEGA_RESULT_v1"], "queue": ["OMEGA_FULLWAVE_QUEUE_v1"]},
  "upgradePolicy": "independent-node-evolution",
  "rules": [
    "Nodes may upgrade UI, renderer, solver, storage and deployment independently.",
    "Breaking protocol changes require a new schema version and overlap window.",
    "Workers never silently mutate CanonState.",
    "Unknown capabilities degrade gracefully instead of blocking unrelated nodes.",
    "Every result preserves packet lineage and solver identity."
  ],
  "nodes": {
    "omega-v6": {"authority": "canonical", "capabilities": ["canon-state","proof-admission","hybrid-link","operator-cockpit","result-ledger"]},
    "omega-genesis": {"authority": "proposal", "capabilities": ["proposal-generation","exploration","candidate-families"]},
    "omega-optical": {"authority": "worker", "capabilities": ["optical-compile","scalar-screen","rank","tier2-queue","visualize"]},
    "omega-sovereign": {"authority": "worker", "capabilities": ["rcwa","fdtd","fem","gpu-batch","measurement-ingest"]}
  }
}