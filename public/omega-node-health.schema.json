{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"OMEGA_NODE_HEALTH_v1",
  "title":"OMEGA Federation Node Health v1",
  "type":"object",
  "required":["schema","node","status","version","capabilities","packet_schemas","checked_at"],
  "properties":{
    "schema":{"const":"OMEGA_NODE_HEALTH_v1"},
    "node":{"enum":["omega-v6","omega-genesis","omega-optical","omega-sovereign"]},
    "status":{"enum":["ready","degraded","offline","maintenance"]},
    "version":{"type":"string"},
    "capabilities":{"type":"array","items":{"type":"string"}},
    "packet_schemas":{"type":"array","items":{"type":"string"}},
    "queue_depth":{"type":"integer","minimum":0},
    "active_jobs":{"type":"integer","minimum":0},
    "last_result_at":{"type":["string","null"]},
    "checked_at":{"type":"string"}
  },
  "additionalProperties":true
}