// OMEGA R115: R114/R113/R112/R111 lineage preserved with machine-grade PROPOSE + SCREEN adapters.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omegav6",
  "main": "src/workerR115.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "services": [
    {"binding":"OMEGA_GENESIS","service":"omega-genesis-v1"},
    {"binding":"OMEGA_GENESIS_MACHINE","service":"omega-genesis-machine-r115"},
    {"binding":"OMEGA_OPTICAL_MACHINE","service":"omega-optical-machine-r115"}
  ],
  "durable_objects": {
    "bindings": [
      {"name": "OMEGA_RUNTIME", "class_name": "OmegaRuntime"}
    ]
  },
  "migrations": [
    {"tag": "r32-enacted-runtime", "new_sqlite_classes": ["OmegaRuntime"]}
  ],
  "observability": {
    "enabled": true
  }
}
