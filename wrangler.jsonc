{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omegav6",
  "main": "src/workerR33.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {"name":"OMEGA_RUNTIME","class_name":"OmegaRuntime"}
    ]
  },
  "migrations": [
    {"tag":"r32-enacted-runtime","new_sqlite_classes":["OmegaRuntime"]}
  ],
  "observability": {
    "enabled": true
  }
}
