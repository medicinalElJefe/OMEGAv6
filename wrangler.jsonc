{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omegav6",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
