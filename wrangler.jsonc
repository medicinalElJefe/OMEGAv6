// OMEGA R125 persistent world extends the proven R116 runtime spine without replacing inherited execution authority.
// Hierarchy remains 1 seed/root -> 12 organs -> 144 branches -> 1,728 stateful cells -> 20,736 lanes; R125 adds one durable canonical-world/provenance root.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omegav6",
  "main": "src/workerR116.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "services": [
    {"binding":"OMEGA_GENESIS","service":"omega-genesis-v1"},
    {"binding":"OMEGA_GENESIS_MACHINE","service":"omega-genesis-machine-r115"},
    {"binding":"OMEGA_OPTICAL_MACHINE","service":"omega-optical-machine-r115"}
  ],
  "durable_objects": {
    "bindings": [
      {"name": "OMEGA_RUNTIME", "class_name": "OmegaRuntime"},
      {"name": "OMEGA_SWARM_CELL", "class_name": "OmegaSwarmCell"},
      {"name": "OMEGA_SWARM_COORDINATOR", "class_name": "OmegaSwarmCoordinator"},
      {"name": "OMEGA_SWARM_BRANCH", "class_name": "OmegaSwarmBranch"},
      {"name": "OMEGA_SWARM_ORGAN", "class_name": "OmegaSwarmOrgan"},
      {"name": "OMEGA_SWARM_ORGANISM", "class_name": "OmegaSwarmOrganismCoordinator"},
      {"name": "OMEGA_WORLD_STATE", "class_name": "OmegaWorldState"}
    ]
  },
  "migrations": [
    {"tag": "r32-enacted-runtime", "new_sqlite_classes": ["OmegaRuntime"]},
    {"tag": "r121-sovereign-swarm", "new_sqlite_classes": ["OmegaSwarmCell", "OmegaSwarmCoordinator"]},
    {"tag": "r123-organism-swarm", "new_sqlite_classes": ["OmegaSwarmBranch", "OmegaSwarmOrgan", "OmegaSwarmOrganismCoordinator"]},
    {"tag": "r125-persistent-world", "new_sqlite_classes": ["OmegaWorldState"]}
  ],
  "observability": {
    "enabled": true
  }
}
