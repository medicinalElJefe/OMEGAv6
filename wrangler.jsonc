// OMEGA R121 sovereign swarm successor on the proven R116/R117 runtime spine.
// Adds 1,728 independently addressable swarm cells + one coordinator while preserving every inherited runtime/federation/archive/mode behavior.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omegav6",
  "main": "src/workerR121.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "services": [
    {"binding":"OMEGA_GENESIS","service":"omega-genesis-v1"},
    {"binding":"OMEGA_GENESIS_MACHINE","service":"omega-genesis-machine-r115"},
    {"binding":"OMEGA_OPTICAL_MACHINE","service":"omega-optical-machine-r115"}
  ],
  "durable_objects": {
    "bindings": [
      {"name": "OMEGA_RUNTIME", "class_name": "OmegaRuntime"},
      {"name": "OMEGA_SWARM_CELL", "class_name": "OmegaSwarmCell"},
      {"name": "OMEGA_SWARM_COORDINATOR", "class_name": "OmegaSwarmCoordinator"}
    ]
  },
  "migrations": [
    {"tag": "r32-enacted-runtime", "new_sqlite_classes": ["OmegaRuntime"]},
    {"tag": "r121-sovereign-swarm", "new_sqlite_classes": ["OmegaSwarmCell", "OmegaSwarmCoordinator"]}
  ],
  "observability": {
    "enabled": true
  }
}
